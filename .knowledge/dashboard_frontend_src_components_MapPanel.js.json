{"is_source_file": true, "format": "JavaScript (React, JSX)", "description": "This file defines a complex React component 'MapPanel' that renders an interactive map using react-leaflet. It displays routes as polylines, checkpoints as circle markers, and includes controls for map view adjustments and fullscreen toggling. The code handles fetching and caching route geometries from OSRM demo server, applies dynamic styling based on route completion and compliance status, and manages user interactions such as route selection. It integrates several utility functions for coordinate transformations, decoding polylines, and styling styles for different map elements.", "external_files": ["../state/domainStore", "leaflet.fullscreen"], "external_methods": ["computeRouteCompletionCriteriaForRoute", "createLruCache", "stableWaypointsHash"], "published": ["MapPanel"], "classes": [], "methods": [{"name": "toLatLngs(polyline = [])", "description": "Converts a polyline array with points having 'lat' and 'lng' into an array of [lat, lng] pairs.", "scope": "", "scopeKind": ""}, {"name": "getEngineer(scopedState, engineerId)", "description": "Retrieves an engineer object by ID from the scopedState.", "scope": "", "scopeKind": ""}, {"name": "getEngineerName(scopedState, engineerId)", "description": "Returns the engineer's name or their ID if the name is unavailable.", "scope": "", "scopeKind": ""}, {"name": "getRegionName(scopedState, regionId)", "description": "Fetches the name of a region given its ID.", "scope": "", "scopeKind": ""}, {"name": "getRegionalManagerName(scopedState, regionId)", "description": "Identifies the regional manager's name for a specific region ID.", "scope": "", "scopeKind": ""}, {"name": "completionTone(route)", "description": "Determines a route's completion status ('success', 'warn', 'error') based on 'completion_percent'.", "scope": "", "scopeKind": ""}, {"name": "complianceBadgeColor(severity)", "description": "Returns color styling info for compliance sev